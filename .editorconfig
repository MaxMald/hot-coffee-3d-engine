# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# All files
[*]
indent_style = space
indent_size = 2
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# C++ files
[*.{cpp,h,hpp,c,cc,cxx}]
indent_style = space
indent_size = 2

# CMake files
[CMakeLists.txt,*.cmake]
indent_style = space
indent_size = 2
