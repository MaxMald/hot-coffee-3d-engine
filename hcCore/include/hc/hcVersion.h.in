#pragma once

#include "hc/hcCorePrerequisites.h"

namespace hc
{
  /**
   * @brief Hot Coffee Engine version information.
   *
   * Provides compile-time constants for the engine version. The values are
   * automatically generated from CMake configuration.
   */
  struct EngineVersion
  {
    static constexpr UInt32 MAJOR = @HC_VERSION_MAJOR@;
    static constexpr UInt32 MINOR = @HC_VERSION_MINOR@;
    static constexpr UInt32 PATCH = @HC_VERSION_PATCH@;
    
    /**
     * @brief Gets the version as a string (e.g., "0.1.0").
     *
     * @return The version string.
     */
    static constexpr const char* ToString()
    {
      return "@HC_VERSION_MAJOR@.@HC_VERSION_MINOR@.@HC_VERSION_PATCH@";
    }
    
    /**
     * @brief Gets the version as a packed integer.
     * 
     * Format: (MAJOR << 16) | (MINOR << 8) | PATCH
     *
     * @return The version as a 32-bit unsigned integer.
     */
    static constexpr UInt32 ToInt()
    {
      return (MAJOR << 16) | (MINOR << 8) | PATCH;
    }
  };
}
